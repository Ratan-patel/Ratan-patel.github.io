<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: the shield icon on the app background, then straight into
         the dashboard. No third-party splash library involved. -->
    <style name="RatanAgentTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/agent_bg</item>
        <item name="android:colorPrimary">@color/agent_accent</item>
        <item name="android:colorAccent">@color/agent_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/agent_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/agent_icon_bg</item>
    </style>
</resources>
