# ---------------------------------------------------------------
# RatanSec OS — environment variables
# Copy karke .env banao:  cp .env.example .env  (phir values bharo)
# ---------------------------------------------------------------

# --- AUTH (public deploy par MUST) -----------------------------
# Dashboard + API ka password. Khaali chhoda to koi bhi access kar sakta hai.
APP_PASSWORD=change-me-strong-password

# --- AI (OpenRouter — apni API key) ----------------------------
# Key yahan se: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model (koi bhi OpenRouter model id). Sasta + tool-calling capable:
MODEL=openai/gpt-4o-mini
# Advanced/behtar reasoning (thoda mehnga):
# MODEL=anthropic/claude-3.5-sonnet
# MODEL=openai/gpt-4o
# MODEL=google/gemini-flash-1.5
AI_MAX_STEPS=4
AI_TIMEOUT=90
MODEL_OVERRIDE_ALLOWED=1

# --- SCOPE (kis par scan allowed hai) --------------------------
# Comma-separated. Domain, subdomain wildcard, IP ya CIDR.
# Example: ALLOWED_TARGETS=example.com,*.mysite.in,10.0.0.0/24
ALLOWED_TARGETS=
# Scope khaali hone par bhi scan allowed ho (tab har action ka manual approval lagega):
ALLOW_ANY_TARGET=1
# Localhost/lab targets allowed (apni practice VM ke liye):
ALLOW_LOCAL_TARGETS=1
# Allowlist ke bahar wale target par (sirf logged-in user ke liye) override allow karo:
ALLOW_SCOPE_OVERRIDE=0
# "", auto, manual — "auto" = scope targets bina poochhe chal jayenge
APPROVAL_MODE=

# --- LIMITS ----------------------------------------------------
MAX_SCAN_SECONDS=420
MAX_CONCURRENT_SCANS=2
MAX_OUTPUT_CHARS=60000

# --- OPTIONAL --------------------------------------------------
# Missing tools dashboard se install karne dena (container me root chahiye):
ALLOW_INSTALL=0
# Boot par nuclei templates update:
UPDATE_NUCLEI_TEMPLATES=0
DATA_DIR=./data
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
