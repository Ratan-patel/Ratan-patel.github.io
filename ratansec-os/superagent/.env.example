# ---------------------------------------------------------------
# RatanSec Super Agent — environment variables
#   cp superagent/.env.example .env     (values bharo)
# ---------------------------------------------------------------

# --- AUTH (internet par deploy kar rahe ho to MUST) ------------
APP_PASSWORD=change-me-strong-password
# Mobile / CLI / API ke liye token (X-Agent-Token header)
SUPERAGENT_API_TOKEN=change-me-long-random-token
# Alag mobile token chahiye to (optional):
# SUPERAGENT_MOBILE_TOKEN=

# --- AI: aapki private API key --------------------------------
SUPERAGENT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SUPERAGENT_BASE_URL=https://openrouter.ai/api/v1
SUPERAGENT_MODEL=openai/gpt-4o-mini
# cheaper/faster:  openai/gpt-4o-mini, google/gemini-flash-1.5, deepseek/deepseek-chat
# strongest:       anthropic/claude-sonnet-4, openai/gpt-4o
SUPERAGENT_MAX_STEPS=8
SUPERAGENT_AI_TIMEOUT=120
SUPERAGENT_MODEL_OVERRIDE=1
# apne gateway ke custom headers: "X-Api-Key: abc, X-Org: team"
# SUPERAGENT_EXTRA_HEADERS=

# --- SCOPE / AUTHORIZATION -----------------------------------
# Static allowlist (record ke bina bhi allowed — sirf tab jab REQUIRE_ROE=0 ho):
SUPERAGENT_ALLOWED_TARGETS=
# Har command ke liye engagement record zaroori (recommended: 1)
SUPERAGENT_REQUIRE_ROE=1
# Koi bhi target (lab mode) — careful!
SUPERAGENT_ALLOW_ANY_TARGET=0
SUPERAGENT_ALLOW_PRIVATE_RANGES=1
SUPERAGENT_ALLOW_INTERNET=1
# "", auto, manual — manual = non-intrusive tools bhi approval maangte hain
SUPERAGENT_APPROVAL_MODE=manual

# --- EXECUTION ------------------------------------------------
# Terminal / shell mode (guard + approval ke saath)
SUPERAGENT_ALLOW_SHELL=1
# Missing tools install endpoint
SUPERAGENT_ALLOW_INSTALL=0
SUPERAGENT_MAX_CMD_SECONDS=300
SUPERAGENT_DEFAULT_TIMEOUT=120
SUPERAGENT_MAX_OUTPUT_CHARS=24000
SUPERAGENT_MAX_CONCURRENT=2

# --- MISC -----------------------------------------------------
SUPERAGENT_DATA_DIR=./data/superagent
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
