# RatanSec Super Agent v2 — copy to ratansec-os/.env and edit locally.
# NEVER commit .env or paste real keys into chat/browser fields.

# --- Console auth (live mode requires at least one) ---
APP_PASSWORD=
SUPERAGENT_API_TOKEN=
# SUPERAGENT_MOBILE_TOKEN=

# --- Private AI provider (server-side only) ---
SUPERAGENT_PROVIDER=openrouter
SUPERAGENT_API_KEY=
SUPERAGENT_BASE_URL=https://openrouter.ai/api/v1
SUPERAGENT_MODEL=
SUPERAGENT_AI_TIMEOUT=90
SUPERAGENT_MAX_STEPS=8
SUPERAGENT_MODEL_OVERRIDE=0
# SUPERAGENT_EXTRA_HEADERS=

# Local Ollama example (no API key needed):
# SUPERAGENT_PROVIDER=ollama
# SUPERAGENT_BASE_URL=http://127.0.0.1:11434/v1
# SUPERAGENT_MODEL=qwen2.5:7b

# --- Authorization / safety ---
SUPERAGENT_REQUIRE_ROE=1
SUPERAGENT_ALLOWED_TARGETS=
SUPERAGENT_ALLOW_ANY_TARGET=0
SUPERAGENT_ALLOW_PRIVATE_RANGES=0
SUPERAGENT_ALLOW_INTERNET=1
SUPERAGENT_APPROVAL_TTL=600

# --- Bounded execution ---
SUPERAGENT_MAX_CMD_SECONDS=120
SUPERAGENT_DEFAULT_TIMEOUT=30
SUPERAGENT_MISSION_TIMEOUT=180
SUPERAGENT_MAX_OUTPUT_CHARS=24000
SUPERAGENT_MAX_CONCURRENT=2

# --- Server / storage ---
SUPERAGENT_DATA_DIR=./data/superagent
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
SUPERAGENT_TRUSTED_PROXY=0

# Offline public demo: fixture missions only, no provider/live actions.
SUPERAGENT_DEMO_MODE=0

# Retired in v2 (ignored if present): SUPERAGENT_ALLOW_SHELL, SUPERAGENT_ALLOW_INSTALL.
