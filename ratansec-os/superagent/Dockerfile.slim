# RatanSec Super Agent — slim image (backend + UI only, ~120 MB)
# Tools host/container par alag install karo: scripts/install-agent-tools.sh
# Build: docker build -f superagent/Dockerfile.slim -t ratansec-superagent-slim .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 SUPERAGENT_DATA_DIR=/data HOST=0.0.0.0 PORT=8000
RUN apt-get update && apt-get install -y --no-install-recommends curl nmap dnsutils whois netcat-openbsd ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY superagent/requirements.txt /app/superagent/requirements.txt
RUN pip install -r /app/superagent/requirements.txt
COPY superagent /app/superagent
COPY scripts /app/scripts
RUN mkdir -p /data && useradd -m -u 1001 agent && chown -R agent:agent /data /app
USER agent
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fsS http://127.0.0.1:8000/healthz || exit 1
CMD ["python3", "-m", "uvicorn", "superagent.webui:app", "--host", "0.0.0.0", "--port", "8000"]
