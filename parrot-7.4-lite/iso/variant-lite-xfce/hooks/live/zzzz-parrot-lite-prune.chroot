#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive
set -- nmap masscan dnsrecon dnsenum zaproxy sqlmap ffuf nikto nuclei wpscan metasploit-framework hydra impacket-scripts netexec smbmap hashcat

purge_matching() {
    regex="$1"
    exclude="${2:-}"
    packages=$(dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' 2>/dev/null \
        | awk -v regex="$regex" -v exclude="$exclude" \
          'substr($1, 1, 2) == "ii" && $2 ~ regex && (exclude == "" || $2 !~ exclude) { print $2 }')
    if [ -n "$packages" ]; then
        printf '%s\n' "$packages" | xargs -r apt-get purge -y
    fi
}

# Drop the full upstream security suites and the office suite first. Then
# explicitly reinstall the selected packages so apt cannot remove one merely
# because it used to be an automatic dependency of a Parrot metapackage.
purge_matching '^(parrot-tools-full|parrot-tools-[^:]+|parrot-meta-(devel|privacy|crypto|security|pentest|full))(:.*)?$' '^parrot-tools-base(:.*)?$'
purge_matching '^(libreoffice|libreoffice-[^:]+|calligra|calligra-[^:]+|abiword|gnumeric)(:.*)?$'

# Drop optional development, container, monitoring and remote-desktop apps
# inherited from a full security-oriented package selection. Keep Java runtime
# packages because OWASP ZAP needs one; remove only the JDK/toolchain.
purge_matching '^(codium|golang-go|nodejs|npm|default-jdk(-headless)?|openjdk-[0-9]+-jdk(-headless)?|python3-pip[^:]*|podman|podman-docker|flatpak|flatpak-xdg-utils|remmina|gufw|thunderbird|wine|wine64|neovim|inxi|neofetch|htop|nload|iftop)(:.*)?$'

printf 'Reinstalling the curated ISO security tools after suite cleanup...\n'
apt-get install --no-install-recommends -y "$@"
apt-mark manual "$@" >/dev/null
apt-get autoremove --purge -y

# Fail closed if a pruning rule or upstream package change dropped a tool.
for package do
    if ! dpkg-query -W -f='${db:Status-Abbrev}\n' "$package" 2>/dev/null | grep -q '^ii'; then
        printf 'Requested curated security tool was removed during cleanup: %s\n' "$package" >&2
        exit 1
    fi
done

unwanted=$(dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' 2>/dev/null \
    | awk 'substr($1, 1, 2) == "ii" && ($2 ~ /^(libreoffice|calligra|abiword|gnumeric|codium|golang-go|nodejs|npm|default-jdk(-headless)?|openjdk-[0-9]+-jdk(-headless)?|python3-pip[^:]*|podman|flatpak|remmina|gufw|thunderbird|wine|wine64|neovim|inxi|neofetch|htop|nload|iftop)/ || ($2 ~ /^parrot-tools-/ && $2 !~ /^parrot-tools-base/) || $2 ~ /^parrot-meta-(devel|privacy|crypto|security|pentest|full)(:.*)?$/) { print $2 }')
if [ -n "$unwanted" ]; then
    printf 'Unexpected heavy/security package remains: %s\n' "$unwanted" >&2
    exit 1
fi

apt-get clean
rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
